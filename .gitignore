*
!.gitignore

# keep top-level dirs traversable
!*/

# tracked source folders
!Adapters/
!Matrix/
!Validator/
!Sets/
!Viewer/
!Sync/
!shared/
!icon/

# tracked files
!main.py
!ARCHITECTURE.md
!build_exe.bat
!Шаблон Excel.xlsx

# keep nested source files in tracked folders
!Adapters/**
!Matrix/**
!Validator/**
!Sets/**
!Viewer/**
!Sync/**
!shared/**
!icon/**

# never track caches/artifacts
**/__pycache__/
*.pyc
